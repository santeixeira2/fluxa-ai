PORT=3000

# Database — in Docker use service name; locally use localhost
DATABASE_URL=postgresql://fluxa:fluxa_secret@postgres:5432/fluxa
POSTGRES_URL=postgresql://fluxa:fluxa_secret@postgres:5432/fluxa

# Redis — in Docker use service name; locally use localhost
REDIS_URL=redis://redis:6379

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d

# Google OAuth (requires a real domain, not an IP)
GOOGLE_CLIENT_ID=

# AI
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ML Service (Oracle Cloud)
ML_SERVICE_URL=

# External APIs
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
EXCHANGE_BASE_URL=https://open.er-api.com/v6
